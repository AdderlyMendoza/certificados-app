# ==========================================================
# Configuración de entorno - certificados-app
# Copia este archivo a .env y ajusta los valores.
# ==========================================================

# --- App ---
APP_NAME="Certificados App"
APP_ENV=development            # development | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Base de datos (MySQL 8) ---
# Si usas Docker, host = "mysql". Si usas MySQL local (XAMPP/WAMP), host = "127.0.0.1".
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=cert_user
MYSQL_PASSWORD=cert_pass
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=certificados

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Seguridad / JWT ---
# Genera una clave fuerte: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_super_secret_key_please_rotate
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Usuario administrador inicial (seed) ---
FIRST_SUPERUSER_EMAIL=admin@certificados.local
FIRST_SUPERUSER_PASSWORD=Admin1234!
FIRST_SUPERUSER_NAME=Administrador

# --- Almacenamiento ---
UPLOAD_DIR=/app/uploads
GENERATED_DIR=/app/generated
MAX_UPLOAD_MB=25

# --- LibreOffice (conversión docx -> pdf) ---
SOFFICE_BIN=soffice
